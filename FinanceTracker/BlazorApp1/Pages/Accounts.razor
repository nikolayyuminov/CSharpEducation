@page "/accounts"

@using BlazorApp1.Models
@using BlazorApp1.Services

@inject AccountApiClient AccountApi

<PageTitle>Счета</PageTitle>

<h3>Счета</h3>

@if (_accounts == null)
{
    <p>Загрузка...</p>
}
else if (_accounts.Count == 0)
{
    <p>У пользователя пока нет счетов.</p>
}
else
{
    <table class="table">
        <thead>
        <tr>
            <th>Название</th>
            <th>Тип</th>
            <th>Баланс</th>
            <th>Закрыт</th>
        </tr>
        </thead>

        <tbody>

        @foreach (var account in _accounts)
        {
            <tr>
                <td>@account.Name</td>
                <td>@account.AccountType</td>
                <td>@account.Balance</td>
                <td>@account.IsClosed</td>
            </tr>
        }

        </tbody>
    </table>
}

@code
{
    private IReadOnlyCollection<AccountModel>? _accounts;

    protected override async Task OnInitializedAsync()
    {
        _accounts = await AccountApi.GetAccountsAsync(1);
    }
}