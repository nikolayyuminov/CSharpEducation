@page "/accounts"

@using BlazorApp1.Models
@using BlazorApp1.Services


@inject AccountApiClient AccountApiClient

<PageTitle>Accounts</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3>Accounts</h3>

    <button class="btn btn-primary"
             data-bs-toggle="modal"
             data-bs-target="#createAccountModal">

        Add account

    </button>
</div>

@if (_isLoading)
{
    <p>Loading...</p>
}
else if (_accounts.Count == 0)
{
    <div class="alert alert-info">
        No accounts found.
    </div>
}
else
{
    <table class="table table-hover table-bordered align-middle">

        <thead class="table-light">
        <tr>
            <th>Name</th>
            <th>Type</th>
            <th>Balance</th>
            <th>Status</th>
        </tr>
        </thead>

        <tbody>

        @foreach (var account in _accounts)
        {
            <tr>

                <td>@account.Name</td>

                <td>@account.AccountType</td>

                <td>@account.Balance</td>

                <td>

                    @if (account.IsClosed)
                    {
                        <span class="badge bg-danger">
                            Closed
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-success">
                            Active
                        </span>
                    }

                </td>

            </tr>
        }

        </tbody>

    </table>
}

<CreateAccountModal AccountCreated="LoadAccounts" />

@code
{
    private IReadOnlyCollection<AccountModel> _accounts = [];

    private bool _isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadAccounts();

        _isLoading = false;
    }
    
    private async Task LoadAccounts()
    {
        _accounts = await AccountApiClient.GetAccountsAsync();
    }
}
