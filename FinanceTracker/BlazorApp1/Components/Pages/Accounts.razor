@page "/accounts"

@using BlazorApp1.Models
@using BlazorApp1.Services
@using FinanceTracker.Domain.Enums

@inject AccountApiClient AccountApiClient

<PageTitle>Accounts</PageTitle>

<div class="container py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h1 class="mb-1">Accounts</h1>
            <p class="text-muted mb-0">
                Manage your financial accounts
            </p>
        </div>

        <button class="btn btn-primary"
                @onclick="OpenCreateModal">
            <span class="me-1">+</span>
            Add account
        </button>

    </div>


    @if (_isLoading)
    {
        <div class="text-center py-5">

            <div class="spinner-border text-primary"
                 role="status">
            </div>

            <div class="mt-2 text-muted">
                Loading accounts...
            </div>

        </div>
    }
    else if (_accounts.Count == 0)
    {
        <div class="card border-0 shadow-sm">

            <div class="card-body text-center py-5">

                <div class="display-6 mb-3">
                    💳
                </div>

                <h4>No accounts yet</h4>

                <p class="text-muted">
                    Create your first account to start tracking your finances.
                </p>

                <button class="btn btn-primary"
                        @onclick="OpenCreateModal">
                    Create account
                </button>

            </div>

        </div>
    }
    else
    {
        <div class="row g-4">

            @foreach (var account in _accounts)
            {
                <div class="col-12 col-md-6 col-xl-4">

                    <div class="card h-100 border-0 shadow-sm">

                        <div class="card-body">

                            <div class="d-flex justify-content-between">

                                <div>
                                    <h5 class="card-title">
                                        @account.Name
                                    </h5>

                                    <div class="text-muted">
                                        @account.AccountType
                                    </div>

                                    <div class="fs-4 fw-bold mt-2">
                                        @account.Balance.ToString("N2")
                                        @account.Currency
                                    </div>
                                </div>

                                <div class="d-flex flex-column align-items-end gap-2">

                                    @if (account.IsClosed)
                                    {
                                        <span class="badge bg-danger">
                                            Closed
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">
                                            Active
                                        </span>
                                        
                                        <button class="btn btn-outline-primary btn-sm"
                                                @onclick="() => OpenRenameModal(account)">
                                            Rename
                                        </button>

                                        <button class="btn btn-outline-danger btn-sm"
                                                @onclick="() => OpenCloseConfirmation(account)">
                                            Close
                                        </button>
                                    }

                                </div>

                            </div>

                        </div>

                    </div>

                </div>
            }

        </div>
    }


</div>


@if (_showCreateModal)
{
    <div class="modal fade show d-block"
         tabindex="-1"
         style="background-color: rgba(0, 0, 0, 0.5);">

        <div class="modal-dialog modal-dialog-centered">

            <div class="modal-content">

                <div class="modal-header">

                    <h5 class="modal-title">
                        Create account
                    </h5>

                    <button type="button"
                            class="btn-close"
                            @onclick="CloseCreateModal">
                    </button>

                </div>

                <div class="modal-body">

                    <CreateAccountModal OnCreated="AccountCreated" />

                </div>

            </div>

        </div>

    </div>
}

@if (_showRenameModal && _accountToRename is not null)
{
    <div class="modal fade show d-block"
         tabindex="-1"
         style="background-color: rgba(0, 0, 0, 0.5);">

        <div class="modal-dialog modal-dialog-centered">

            <div class="modal-content">

                <div class="modal-header">

                    <h5 class="modal-title">
                        Rename account
                    </h5>

                    <button type="button"
                            class="btn-close"
                            @onclick="CloseRenameModal">
                    </button>

                </div>

                <EditForm Model="_renameModel"
                          OnValidSubmit="ConfirmRename">

                    <div class="modal-body">

                        <div class="mb-3">

                            <label class="form-label">
                                Account name
                            </label>

                            <InputText class="form-control"
                                       @bind-Value="_renameModel.NewName" />

                        </div>

                    </div>

                    <div class="modal-footer">

                        <button type="button"
                                class="btn btn-secondary"
                                @onclick="CloseRenameModal">
                            Cancel
                        </button>

                        <button type="submit"
                                class="btn btn-primary">
                            Save
                        </button>

                    </div>

                </EditForm>

            </div>

        </div>

    </div>
}

@if (_showCloseConfirmation && _accountToClose is not null)
{
    <div class="modal fade show d-block"
         tabindex="-1"
         style="background-color: rgba(0, 0, 0, 0.5);">

        <div class="modal-dialog modal-dialog-centered">

            <div class="modal-content">

                <div class="modal-header">
                    <h5 class="modal-title">
                        Close account
                    </h5>

                    <button type="button"
                            class="btn-close"
                            @onclick="CancelClose">
                    </button>
                </div>

                <div class="modal-body">

                    <p>
                        Are you sure you want to close
                        <strong>@_accountToClose.Name</strong>?
                    </p>

                    <p class="text-muted mb-0">
                        A closed account cannot be used for new transactions.
                    </p>

                </div>

                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-secondary"
                            @onclick="CancelClose">
                        Cancel
                    </button>

                    <button type="button"
                            class="btn btn-danger"
                            @onclick="ConfirmClose">
                        Close account
                    </button>

                </div>

            </div>

        </div>

    </div>
}

@code
{
    #region Поля
    
    private bool _showCloseConfirmation;

    private AccountModel? _accountToClose;
    
    private bool _showRenameModal;

    private AccountModel? _accountToRename;
    
    private RenameAccountModel _renameModel = new();

    private IReadOnlyCollection<AccountModel> _accounts = [];

    private bool _isLoading = true;

    private bool _showCreateModal;

    #endregion


    #region Методы

    private async Task LoadAccountsAsync()
    {
        _accounts = await AccountApiClient.GetAccountsAsync();
    }


    private void OpenCreateModal()
    {
        _showCreateModal = true;
    }


    private void CloseCreateModal()
    {
        _showCreateModal = false;
    }


    private async Task AccountCreated()
    {
        _showCreateModal = false;

        await LoadAccountsAsync();
    }
    
    private void OpenRenameModal(AccountModel account)
    {
        _accountToRename = account;
        
        _renameModel = new RenameAccountModel
        {
            NewName = account.Name
        };
        
        _showRenameModal = true;
    }

    private void CloseRenameModal()
    {
        _showRenameModal = false;
        _accountToRename = null;
    }

    private async Task ConfirmRename()
    {
        if (_accountToRename is null)
            return;

        await AccountApiClient.RenameAccountAsync(
            _accountToRename.Id,
            _renameModel.NewName);

        _accountToRename = null;
        _showRenameModal = false;

        await LoadAccountsAsync();
    }
    
    private void OpenCloseConfirmation(AccountModel account)
    {
        _accountToClose = account;
        _showCloseConfirmation = true;
    }
    
    private void CancelClose()
    {
        _accountToClose = null;
        _showCloseConfirmation = false;
    }
    
    private async Task ConfirmClose()
    {
        if (_accountToClose is null)
            return;

        await AccountApiClient.CloseAccountAsync(_accountToClose.Id);

        _accountToClose = null;
        _showCloseConfirmation = false;

        await LoadAccountsAsync();
    }
    
    #endregion


    #region Жизненный цикл

    protected override async Task OnInitializedAsync()
    {
        await LoadAccountsAsync();

        _isLoading = false;
    }

    #endregion
}