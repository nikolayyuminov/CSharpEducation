@page "/categories"

@using BlazorApp1.Models
@using BlazorApp1.Services
@using FinanceTracker.Domain.Enums

@inject CategoryApiClient CategoryApiClient  

<PageTitle>Categories</PageTitle>

<div class="container py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h1 class="mb-1">Categories</h1>
            <p class="text-muted mb-0">
                Manage your financial Categories
            </p>
        </div>
    </div>
    @if (_isLoading)
    {
        <div class="text-center py-5">

            <div class="spinner-border text-primary"
                 role="status">
            </div>

            <div class="mt-2 text-muted">
                Loading categories...
            </div>

        </div>
    }
    else if (_categories.Count == 0)
    {
        <div class="card border-0 shadow-sm">

            <div class="card-body text-center py-5">

                <div class="display-6 mb-3">
                    📊
                </div>

                <h4>No categories yet</h4>

                <p class="text-muted">
                    Create your first category.
                </p>

            </div>

        </div>
    }
    else
    {
        <div class="row g-4">

            @foreach (var category in _categories)
            {
                <div class="col-12 col-md-6 col-xl-4">

                    <div class="card h-100 border-0 shadow-sm">

                        <div class="card-body">

                            <div class="d-flex justify-content-between">

                                <div>
                                    <h5 class="card-title">
                                        @category.Name
                                    </h5>

                                    <div class="text-muted">
                                        @category.CategoryKind
                                    </div>

                                    <div class="fs-4 fw-bold mt-2">
                                        @category.Description
                                    </div>
                                </div>

                                <div class="d-flex flex-column align-items-end gap-2">

                                    @if (category.IsArchived)
                                    {
                                        <span class="badge bg-danger">
                                            Archived
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">
                                            Active
                                        </span>
                                    }

                                </div>

                            </div>

                        </div>

                    </div>

                </div>
            }

        </div>
    }
</div>

@code
{
    #region Поля
    
    private IReadOnlyCollection<CategoryModel> _categories = [];
    
    private bool _isLoading = true;
    
    private bool _showCreateModal;
    
    #endregion
    
    #region Методы
    
    private async Task LoadCategoryAsync()
    {
        _categories = await CategoryApiClient.GetCategoryAsync();
    }
    
    private void OpenCreateModal()
    {
        _showCreateModal = true;
    }
    
    #endregion
    
    #region Жизненный цикл

    protected override async Task OnInitializedAsync()
    {
        await LoadCategoryAsync();

        _isLoading = false;
    }
    
    #endregion
}